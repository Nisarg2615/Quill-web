# Leadgen Configuration Example

# Contact Email (used in User-Agent for OpenStreetMap requests)
CONTACT_EMAIL=your_email@example.com

# Sender Info
SENDER_NAME=Quillweb Team
SENDER_TITLE=Website Design & Optimization

# Gmail Credentials (Direct via smtp.gmail.com)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: Google Gemini API key for AI drafting (from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Google PageSpeed API key
PAGESPEED_API_KEY=your_pagespeed_api_key
